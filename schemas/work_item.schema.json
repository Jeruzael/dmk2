{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 100000
    },
    "relatedIds": {
      "default": [],
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[a-zA-Z0-9._:-]+$"
      }
    },
    "sources": {
      "default": [],
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "parentId": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-zA-Z0-9._:-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "dependencies": {
      "default": [],
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[a-zA-Z0-9._:-]+$"
      }
    },
    "sourceIdentifier": {
      "default": "",
      "type": "string",
      "maxLength": 2000
    },
    "sourceNamespace": {
      "default": "",
      "type": "string",
      "maxLength": 2000
    },
    "sourceStatus": {
      "default": "UNKNOWN",
      "type": "string",
      "maxLength": 2000
    },
    "executionStatus": {
      "default": "unknown",
      "type": "string",
      "enum": [
        "unknown",
        "backlog",
        "in-progress",
        "partial",
        "blocked",
        "completed",
        "future"
      ]
    },
    "acceptanceCriteria": {
      "default": [],
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "owner": {
      "default": "",
      "type": "string",
      "maxLength": 2000
    },
    "evidence": {
      "default": [],
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "lastSourceRevision": {
      "default": "",
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "title"
  ],
  "additionalProperties": false
}
