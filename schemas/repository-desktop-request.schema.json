              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
            }
          },
          "required": [
            "projectId",
            "expectedRevision",
            "operationId",
            "origin"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "action",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
