            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[a-zA-Z0-9._:-]+$"
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "operationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[a-zA-Z0-9._:-]+$"
            },
            "origin": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
            }
          },
          "required": [
            "projectId",
            "expectedRevision",
            "operationId",
            "origin"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "action",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
