  "oneOf": [
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "get"
        },
        "args": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[a-zA-Z0-9._:-]+$"
            }
          },
          "required": [
            "projectId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
