{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 100000
    },
    "relatedIds": {
      "default": [],
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[a-zA-Z0-9._:-]+$"
      }
    },
    "sources": {
      "default": [],
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "category": {
      "default": "general",
      "type": "string",
      "maxLength": 2000
    },
    "markdown": {
      "default": "",
      "type": "string",
      "maxLength": 100000
    },
    "repositoryPath": {
      "default": "",
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "title"
  ],
  "additionalProperties": false
}
