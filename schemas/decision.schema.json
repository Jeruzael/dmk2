{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 100000
    },
    "relatedIds": {
      "default": [],
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[a-zA-Z0-9._:-]+$"
      }
    },
    "sources": {
      "default": [],
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "alternatives": {
      "default": [],
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "selectedOption": {
      "default": "",
      "type": "string",
      "maxLength": 100000
    },
    "rationale": {
      "default": "",
      "type": "string",
      "maxLength": 100000
    },
    "consequences": {
      "default": "",
      "type": "string",
      "maxLength": 100000
    },
    "status": {
      "default": "proposed",
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "superseded",
        "rejected",
        "deferred"
      ]
    },
    "confirmation": {
      "default": {
        "claimed": false,
        "conversationRef": ""
      },
      "type": "object",
      "properties": {
        "claimed": {
          "type": "boolean"
        },
        "conversationRef": {
          "default": "",
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "claimed"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "title"
  ],
  "additionalProperties": false
}
