{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 100000
    },
    "relatedIds": {
      "default": [],
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[a-zA-Z0-9._:-]+$"
      }
    },
    "sources": {
      "default": [],
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "recordType": {
      "default": "component",
      "type": "string",
      "enum": [
        "component",
        "relationship",
        "proposal",
        "verification"
      ]
    },
    "technology": {
      "default": "",
      "type": "string",
      "maxLength": 2000
    },
    "fromId": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-zA-Z0-9._:-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "toId": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-zA-Z0-9._:-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "default": "proposed",
      "type": "string",
      "enum": [
        "proposed",
        "selected",
        "implemented",
        "verified",
        "deferred"
      ]
    },
    "verification": {
      "default": [],
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  },
  "required": [
    "title"
  ],
  "additionalProperties": false
}
